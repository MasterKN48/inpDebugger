{
  "productName": "INP Debugger",
  "version": "0.1.0",
  "identifier": "com.inpdebugger.app",
  "build": {
    "beforeDevCommand": "bun run --filter web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run --filter web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "INP Debugger",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
