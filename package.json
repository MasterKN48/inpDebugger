{
  "name": "inpdebugger",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:server & bun run dev:web",
    "dev:server": "bun --watch apps/server/index.js",
    "dev:web": "bun run --cwd apps/web dev"
  },
  "dependencies": {
    "elysia": "0.8.17",
    "@elysiajs/swagger": "0.8.5"
  },
  "devDependencies": {
    "bun-types": "1.1.0"
  }
}